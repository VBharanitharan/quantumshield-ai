# Copy these into Vercel: Project -> Settings -> Environment Variables.
# DATABASE_URL is added for you when you connect a Neon database from the Storage tab.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-random-hex-characters
